local function createSwitch(name, callback, layoutOrder)
    local container = Instance.new("Frame")
    container.Parent = ScrollFrame
    container.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
    container.BorderSizePixel = 0
    container.Size = UDim2.new(1, 0, 0, 32)
    container.LayoutOrder = layoutOrder
    container.CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Parent = container
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 10, 0, 0)
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Font = Enum.Font.Gotham
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left

    local switch = Instance.new("TextButton")
    switch.Parent = container
    switch.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    switch.Position = UDim2.new(0.85, 0, 0.5, -10)
    switch.Size = UDim2.new(0, 40, 0, 20)
    switch.Text = ""
    switch.CornerRadius = UDim.new(1, 0)

    local toggle = Instance.new("Frame")
    toggle.Parent = switch
    toggle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggle.Position = UDim2.new(0, 2, 0.5, -8)
    toggle.Size = UDim2.new(0, 16, 0, 16)
    toggle.CornerRadius = UDim.new(1, 0)

    local isOn = false
    switch.MouseButton1Click:Connect(function()
        isOn = not isOn
        switch.BackgroundColor3 = isOn and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(80, 80, 80)
        TweenService:Create(toggle, TweenInfo.new(0.15), {Position = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
        callback(isOn)
    end)

    return container
end

-- ฟังก์ชันสร้างสไลด์เดอร์
local function createSlider(name, min, max, default, callback, layoutOrder)
    local container = Instance.new("Frame")
    container.Parent = ScrollFrame
    container.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
    container.Size = UDim2.new(1, 0, 0, 45)
    container.LayoutOrder = layoutOrder
    container.CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Parent = container
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 10, 0, 2)
    label.Size = UDim2.new(1, -20, 0, 16)
    label.Font = Enum.Font.Gotham
    label.Text = name .. ": " .. default
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 12
    label.Tag = "ValueLabel"

    local barBg = Instance.new("Frame")
    barBg.Parent = container
    barBg.BackgroundColor3 = Color3.fromRGB(60, 0, 0)
    barBg.Position = UDim2.new(0, 10, 0, 22)
    barBg.Size = UDim2.new(1, -20, 0, 8)
    barBg.CornerRadius = UDim.new(1, 0)

    local barFill = Instance.new("Frame")
    barFill.Parent = barBg
    barFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    barFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    barFill.CornerRadius = UDim.new(1, 0)

    local value = default
    barBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local function update()
                local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                value = math.floor(min + pos * (max - min))
                barFill.Size = UDim2.new(pos, 0, 1, 0)
                label.Text = name .. ": " .. value
                callback(value)
            end
            update()
            input.Changed:Connect(function(changed)
                if changed == Enum.UserInputState.End then return end
                update()
            end)
            UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType == Enum.UserInputType.MouseButton1 then
                    -- จบการลาก
                end
            end)
        end
    end)
end

-- ฟังก์ชันสร้างช่องใส่ข้อความ
local function createTextBox(name, placeholder, callback, layoutOrder)
    local container = Instance.new("Frame")
    container.Parent = ScrollFrame
    container.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
    container.Size = UDim2.new(1, 0, 0, 40)
    container.LayoutOrder = layoutOrder
    container.CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Parent = container
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 10, 0, 0)
    label.Size = UDim2.new(1, -20, 0, 16)
    label.Font = Enum.Font.Gotham
    label.Text = name
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left

    local box = Instance.new("TextBox")
    box.Parent = container
    box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    box.Position = UDim2.new(0, 10, 0, 18)
    box.Size = UDim2.new(1, -20, 0, 20)
    box.Font = Enum.Font.Gotham
    box.Text = placeholder
    box.TextColor3 = Color3.fromRGB(100, 100, 100)
    box.TextSize = 11
    box.ClearTextOnFocus = true
    box.FocusLost:Connect(function(enterPressed)
        if enterPressed and box.Text ~= "" then
            callback(box.Text)
            box.Text = placeholder
            box.TextColor3 = Color3.fromRGB(100, 100, 100)
        end
    end)
    box.Focused:Connect(function()
        box.TextColor3 = Color3.fromRGB(0, 0, 0)
    end)
end

