                    lbl.Text = player.Name .. " | " .. math.floor(hum.Health) .. "HP"
                    lbl.TextColor3 = Color3.fromRGB(255, 0, 0)
                    lbl.TextSize = 12
                    lbl.Font = Enum.Font.GothamBold
                    lbl.Parent = esp
                    espObjects[player.Name] = esp
                end
            end
        end
    else
        for _, v in pairs(espObjects) do v:Destroy() end
        espObjects = {}
    end
