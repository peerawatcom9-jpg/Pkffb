createSwitch("📦 เก็บของอัตโนมัติ", function(on)
    status.AutoCollect.Enabled = on
    connections.AutoCollect = RunService.Heartbeat:Connect(function()
        if not rootPart or not on then return end
        for _, v in ipairs(workspace:GetChildren()) do
            if v:IsA("BasePart") and v:GetAttribute("Pickup") or v.Name:find("Coin") or v.Name:find("Egg") then
                local dist = (v.Position - rootPart.Position).Magnitude
                if dist < 20 then
                    v.Velocity = (rootPart.Position - v.Position).Unit * 15
   
